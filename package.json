{
  "name": "aeroshield-ai",
  "version": "1.0.0",
  "description": "GenAI-Powered Winter Smog & Urban Air Pollution Navigator for Families & Communities",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm install && npm run build",
    "vercel-build": "cd client && npm install && npm run build",
    "test": "vitest run && npm --prefix client test",
    "test:server": "vitest run",
    "test:client": "npm --prefix client test",
    "test:watch": "vitest",
    "test:api": "node test-api.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "air-quality",
    "smog",
    "pm25",
    "aqi",
    "genai",
    "gemini",
    "corsi-rosenthal",
    "indoor-air-quality",
    "low-emission"
  ],
  "author": "Google DeepMind Antigravity",
  "license": "MIT"
}
